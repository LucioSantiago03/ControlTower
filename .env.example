# Copie este arquivo para .env e preencha com as suas credenciais.
# O .env NÃO deve ir para o Git; este .env.example sim.

# Chaves S3 do Supabase Storage (bucket DataLakeVertice)
# Ficam no painel do Supabase: Project Settings > Storage > S3 Connection > Access keys
ACCESS_KEY=sua_access_key_aqui
SECRET_KEY=sua_secret_key_aqui
